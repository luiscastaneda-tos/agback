{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "reason", "questions", "task"],
  "properties": {
    "action": { "type": "string", "enum": ["dispatch", "complete", "human_gate", "blocked"] },
    "reason": { "type": "string" },
    "questions": { "type": "array", "items": { "type": "string" } },
    "task": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "parent_backlog_id", "title", "objective", "risk", "allowed_paths", "forbidden_paths", "requirements", "acceptance", "notes"],
          "properties": {
            "id": { "type": "string" },
            "parent_backlog_id": { "type": "string" },
            "title": { "type": "string" },
            "objective": { "type": "string" },
            "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
            "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "forbidden_paths": { "type": "array", "items": { "type": "string" } },
            "requirements": { "type": "array", "items": { "type": "string" } },
            "acceptance": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
