{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "questions"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approve", "changes_requested", "human_gate"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "detail", "file"],
        "properties": {
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "file": { "type": "string" }
        }
      }
    },
    "questions": { "type": "array", "items": { "type": "string" } }
  }
}
